node('JDK8') {
    stage('Checkout Code') {
        git branch: 'sprint1_develop', url: 'https://github.com/mailrajeshsre/game-of-life.git'
    }

    stage('Build using Java 8') {
        withEnv(["JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64", "PATH=/usr/lib/jvm/java-8-openjdk-amd64/bin:$PATH"]) {
            sh 'java -version'   // Should show Java 8
            sh 'mvn clean package'
        }
    }

    stage('Archive & Test Results') {
        junit testResults: '**/surefire-reports/*.xml'
        archiveArtifacts artifacts: '**/*.war', followSymlinks: false
    }
}
